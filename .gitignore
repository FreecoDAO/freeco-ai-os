# Build
/target
**/*.rs.bk
*.pdb
__pycache__/
*.py[cod]

# Environment & secrets
.env
.env.*
!.env.example

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# User config (may contain API keys)
config.toml

# Certificates & keys
*.pem
*.key
*.cert
*.p12
*.pfx

# Runtime artifacts
collector_hand_state.json
collector_knowledge_base.json
predictions_database.json
prediction_report_*.md
BUILD_LOG.md

# OS
.DS_Store
._*
Thumbs.db

# IDE & tools
.idea/
.vscode/
.claude/
*.swp
*.swo
*~
.serena/

# Personal deploy scripts
scripts/deploy-remote.sh

# Build/packaging output
dist/

# Skills are shared, not local settings: they must travel with the repo so
# every agent working here gets them. The rest of .claude/ stays ignored
# because it holds per-machine state.
!.claude/skills/
!.claude/skills/**
